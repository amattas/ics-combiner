# Authentication (optional for local/dev)
ICS_API_KEY=your-long-random-api-key
SALT=optional-salt  # legacy: MD5_SALT

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=false

# Cache (optional; with neither setting, caching is disabled)
# PostgreSQL: the service's own database; the cache_entries table is created on first use
# DATABASE_URL=postgresql://user:password@host:5432/ics_combiner?sslmode=require
# Process-local cache for local development (takes precedence over DATABASE_URL)
# CACHE_BACKEND=memory
# Optional namespace for cache keys (derived from ICS_API_KEY when unset)
# ICS_CACHE_NAMESPACE=family

# ICS configuration
ICS_NAME=Combined Calendar
ICS_DAYS_HISTORY=14

# Example sources JSON (paste into ICS_SOURCES)
# [
#   {
#     "Id": 1,
#     "Url": "https://example.com/calendar1.ics",
#     "Prefix": "Work",
#     "MakeUnique": true,
#     "FilterDuplicates": false,
#     "PadStartMinutes": 15,
#     "Duration": 60,
#     "RefreshSeconds": 900
#   },
#   {
#     "Id": 2,
#     "Url": "https://example.com/calendar2.ics",
#     "Prefix": "Home",
#     "MakeUnique": false,
#     "FilterDuplicates": true,
#     "RefreshSeconds": 600
#   }
# ]
ICS_SOURCES=

# Cache TTL overrides
# Default TTL for any source without explicit RefreshSeconds
CACHE_TTL_ICS_SOURCE_DEFAULT=600
# Last-known-good fallback TTL
CACHE_TTL_ICS_SOURCE_LKG=86400
# Failure backoff TTL
CACHE_TTL_ICS_SOURCE_FAILURE_BACKOFF=60
# Backoff TTL after HTTP 429 without Retry-After
CACHE_TTL_ICS_SOURCE_RATE_LIMIT_BACKOFF=3600
